# Copy this file to .env and fill it in. Never commit .env.

# Postgres connection string. `docker compose up -d` gives you this one locally;
# in production use the one from Neon / Supabase / Render.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doxxd

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated list of frontend URLs allowed to call the API.
# Leave empty when running on your own machine; set it to your site's URL when deployed.
CORS_ORIGINS=

PORT=3000
